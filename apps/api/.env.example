# Copiar a .env y completar. NUNCA commitear el .env real.
# cp .env.example .env

ENVIRONMENT=development
DEBUG=true

# --- Base de datos ---
DATABASE_URL=postgresql+psycopg://chatbot:chatbot@localhost:5432/chatbot

# --- Anthropic (motor del chatbot) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# claude-haiku-4-5 por defecto: elegido con evidencia del harness en evals/
# (mismo resultado en los checks automaticos que opus-5/sonnet-5, mucho menos
# costo y latencia). LLM_EFFORT solo aplica a la familia Claude 5 (opus-5,
# sonnet-5), no a Haiku 4.5.
LLM_MODEL=claude-haiku-4-5
LLM_MAX_TOKENS=4096
LLM_EFFORT=medium

# --- Embeddings ---
# Anthropic no tiene endpoint de embeddings; el RAG usa un proveedor aparte.
# https://dash.voyageai.com
# Si tu cuenta tiene credito solo en ciertos modelos, usa uno de uso general
# (voyage-4 / voyage-4-lite / voyage-4-large), no uno especializado
# (code/law/finance/multimodal). Si cambias de modelo, verifica EMBEDDINGS_DIM
# con una llamada real primero: la columna de Postgres es de tamano fijo.
VOYAGE_API_KEY=
EMBEDDINGS_MODEL=voyage-4
EMBEDDINGS_DIM=1024

# --- Memoria conversacional ---
# Mensajes previos que se reenvian en cada turno. Es la palanca directa del
# costo por mensaje (10 = ~5 intercambios).
CONVERSATION_HISTORY_MESSAGES=10
# Inactividad tras la cual se abre una conversacion nueva (24 h).
CONVERSATION_IDLE_MINUTES=1440

# --- Cuotas ---
# Tope mensual con el que nace cada cliente nuevo. Ajustable por cliente despues.
DEFAULT_MONTHLY_MESSAGE_LIMIT=5000

# --- WhatsApp Cloud API (Meta) ---
# Estos dos son de TU App de Meta y valen para todos los clientes.
# El access token, en cambio, es de cada cliente y se carga desde el panel.
# VERIFY_TOKEN lo inventas vos: tiene que coincidir con el que pongas en Meta
# al registrar el webhook.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Coexistence (el comercio contesta a mano desde su celular) ---
# Deja que el mismo numero este a la vez en la app de WhatsApp Business y en la
# Cloud API: cuando el duenio contesta desde el telefono, Meta nos avisa y el
# bot se pausa solo en ese hilo.
#
# ★ DEJALO EN false hasta confirmar el payload real de `smb_message_echoes`
# contra un numero de prueba. Con esto apagado, los echoes que lleguen quedan
# crudos en el log -que es justamente como se confirma- y no se actua sobre
# ellos. Ver docs/coexistence.md.
COEXISTENCE_ENABLED=false

# --- Alta de clientes por Embedded Signup ---
# Con esto el cliente conecta su WhatsApp solo: entra a un link, se loguea con
# Facebook, elige su numero y listo. No toca Business Manager ni pega tokens.
#
# APP_ID lo ves en el Meta App Dashboard (arriba de todo, junto al nombre).
# CONFIG_ID se genera en "Facebook Login for Business" -> Configurations (NO bajo
# WhatsApp): es la configuracion del popup (que permisos pide, que pasos ve el
# cliente y cuanto dura el token). Ojo: la plantilla por defecto de Meta emite
# tokens de 60 dias, que dejan al bot mudo a los dos meses.
# Los dos son publicos: viajan al navegador. El secreto es WHATSAPP_APP_SECRET.
WHATSAPP_APP_ID=
WHATSAPP_CONFIG_ID=

# A donde apunta el link que se le manda al cliente: la URL del panel (apps/web).
# En produccion tiene que ser https: el link lleva un token en la URL.
ONBOARDING_BASE_URL=http://localhost:3000

# Cuanto vive el link antes de vencer. Si se pasa, se genera otro desde el panel.
ONBOARDING_LINK_TTL_HOURS=72

# --- Reporte de errores ---
# Sin DSN no se manda nada. Se saca de sentry.io al crear un proyecto Python.
# NUNCA recibe el contenido de los mensajes, solo el stack y el tenant_id
# (ver app/core/monitoreo.py).
SENTRY_DSN=

# --- Seguridad ---
JWT_SECRET=
# Cifra los access tokens de WhatsApp de cada cliente. Generar con:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# OJO: si la perdes o la cambias, hay que volver a cargar todos los tokens.
ENCRYPTION_KEY=
