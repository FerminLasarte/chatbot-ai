# Copiar a .env y completar. NUNCA commitear el .env real.
# cp .env.example .env

ENVIRONMENT=development
DEBUG=true

# --- Base de datos ---
DATABASE_URL=postgresql+psycopg://chatbot:chatbot@localhost:5432/chatbot

# --- Anthropic (motor del chatbot) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=4096
LLM_EFFORT=medium

# --- Embeddings ---
# Anthropic no tiene endpoint de embeddings; el RAG usa un proveedor aparte.
# https://dash.voyageai.com
VOYAGE_API_KEY=
EMBEDDINGS_MODEL=voyage-3
EMBEDDINGS_DIM=1024

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Seguridad ---
JWT_SECRET=
