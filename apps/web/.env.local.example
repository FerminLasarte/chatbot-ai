# Copiar a .env.local. NUNCA commitear el .env.local real.

# --- Pantalla de prueba (/probar) --- SOLO DESARROLLO
# Esa pantalla no existe en el sitio desplegado, asi que estas dos no van en
# Railway: son para probar el motor en tu maquina.
# OJO igual: todo lo que empieza con NEXT_PUBLIC_ queda incrustado en el
# JavaScript que descarga el navegador. La clave de abajo tiene scope `tenant`
# y puede subir documentos; que sea de un tenant de prueba, nunca de un cliente.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=

# --- Panel de administracion (/panel) ---
# Estas NO llevan NEXT_PUBLIC_: se leen solo en el servidor y nunca llegan al
# navegador. La clave admin puede operar sobre TODOS los clientes.
API_URL=http://localhost:8000
ADMIN_API_KEY=
# Contrasena para entrar al panel.
PANEL_PASSWORD=
# Firma la cookie de sesion. Generala con: openssl rand -hex 32
PANEL_SECRET=
