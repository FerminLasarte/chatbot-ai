# Copiar a .env.local. NUNCA commitear el .env.local real.

# --- Pagina de demo (widget de chat) ---
# OJO: todo lo que empieza con NEXT_PUBLIC_ queda incrustado en el JavaScript
# que descarga el navegador. Es publico por definicion. Aca va solo una clave
# de demo; nunca la de un cliente real.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=

# --- Panel de administracion (/panel) ---
# Estas NO llevan NEXT_PUBLIC_: se leen solo en el servidor y nunca llegan al
# navegador. La clave admin puede operar sobre TODOS los clientes.
API_URL=http://localhost:8000
ADMIN_API_KEY=
# Contrasena para entrar al panel.
PANEL_PASSWORD=
# Firma la cookie de sesion. Generala con: openssl rand -hex 32
PANEL_SECRET=
